<Window x:Class="IPManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IPManager.App.ViewModels"
        Title="IP Manager"
        Height="820" Width="1360" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource NavBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="18,20,12,18">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="IP" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="IP Manager" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="LAN address organizer" Style="{StaticResource MutedText}" FontSize="10.5" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Navigation}"
                         SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         Margin="10,0,10,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="27" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="16,8,16,16">
                    <TextBlock Text="No telemetry · local database" Style="{StaticResource MutedText}" FontSize="10.5" />
                    <TextBlock Text="Version 1.0.0" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageHeader}" FontSize="21" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="260" Margin="0,0,10,0">
                            <TextBox Text="{Binding GlobalSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search device name, IP, MAC, hostname, vendor or tag and press Enter">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Search devices…" IsHitTestVisible="False" Margin="11,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding GlobalSearch, Converter={StaticResource EmptyToVisibility}}" />
                        </Grid>
                        <Button Style="{StaticResource IconButton}" Command="{Binding SearchCommand}" Content="&#xE721;"
                                ToolTip="Search" Margin="0,0,4,0" />
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" Content="&#xE706;"
                                ToolTip="Toggle light / dark theme" Margin="0,0,4,0" />
                        <Button Style="{StaticResource IconButton}" Command="{Binding GoAlertsCommand}"
                                ToolTip="Alerts">
                            <Grid>
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource DangerBrush}" CornerRadius="8" MinWidth="15" Height="15"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0"
                                        Visibility="{Binding UnreadAlerts, Converter={StaticResource EmptyToVisibility}, ConverterParameter=invert}">
                                    <TextBlock Text="{Binding UnreadAlerts}" Foreground="White" FontSize="9"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="18,16,18,12"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <Border Grid.Row="2" Background="{DynamicResource NavBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,6">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="900" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusTime, StringFormat='{}{0:HH:mm:ss}'}" HorizontalAlignment="Right"
                               Style="{StaticResource MutedText}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
