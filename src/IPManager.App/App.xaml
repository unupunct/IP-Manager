<Application x:Class="IPManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:IPManager.App.Infrastructure"
             xmlns:vm="clr-namespace:IPManager.App.ViewModels"
             xmlns:views="clr-namespace:IPManager.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <infra:InverseBoolConverter x:Key="InverseBool" />
            <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
            <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
            <infra:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <infra:BoolToTextConverter x:Key="BoolToText" />
            <infra:EnumTextConverter x:Key="EnumText" />
            <infra:UtcToLocalConverter x:Key="UtcToLocal" />
            <infra:SeverityBrushConverter x:Key="SeverityBrush" />
            <infra:IpStatusBrushConverter x:Key="IpStatusBrush" />
            <infra:DeviceStatusBrushConverter x:Key="DeviceStatusBrush" />
            <infra:ConflictStateBrushConverter x:Key="ConflictStateBrush" />
            <infra:ConfidenceBrushConverter x:Key="ConfidenceBrush" />

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LocalAddressesViewModel}">
                <views:LocalAddressesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiscoveryViewModel}">
                <views:DiscoveryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
                <views:DevicesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:IpManagerViewModel}">
                <views:IpManagerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SubnetCalculatorViewModel}">
                <views:SubnetCalculatorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SubnetManagerViewModel}">
                <views:SubnetManagerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DhcpViewModel}">
                <views:DhcpView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DnsViewModel}">
                <views:DnsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConflictsViewModel}">
                <views:ConflictsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkMapViewModel}">
                <views:NetworkMapView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MonitoringViewModel}">
                <views:MonitoringView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                <views:DiagnosticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
                <views:AlertsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
