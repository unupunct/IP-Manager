<UserControl x:Class="IPManager.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="165" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SubnetOptions}" SelectedItem="{Binding SelectedSubnet, Mode=TwoWay}" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Grid.Column="3" Margin="0,0,8,0">
                    <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="From date (yyyy-MM-dd)" />
                    <TextBlock Text="From" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding FromDate, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <Grid Grid.Column="4" Margin="0,0,8,0">
                    <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="To date (yyyy-MM-dd)" />
                    <TextBlock Text="To" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding ToDate, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Content="Build" Command="{Binding BuildCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                    <Button Content="Clear dates" Command="{Binding ClearDatesCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding PreviewTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PreviewSubtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ExportSummary}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LastExportPath}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding RowCount}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="rows" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding ColumnCount}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="columns" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <Button Content="CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="JSON" Command="{Binding ExportJsonCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Export all (CSV)" Command="{Binding ExportAllCommand}" Style="{StaticResource AccentButton}" Padding="10,4" MinHeight="26" FontSize="11.5" Margin="0,0,6,0" />
                    <Button Content="Open folder" Command="{Binding OpenExportsCommand}" Style="{StaticResource SmallButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PreviewHeaders}" Margin="8,8,8,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="150" Background="{DynamicResource PanelAltBrush}" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1">
                                    <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="8,0,8,8">
                    <ItemsControl ItemsSource="{Binding PreviewRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="150" Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,1" MinHeight="26">
                                                <TextBlock Text="{Binding}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Text="Build a report to see a preview." HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
