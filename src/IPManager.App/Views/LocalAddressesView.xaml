<UserControl x:Class="IPManager.App.Views.LocalAddressesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:IPManager.Core;assembly=IPManager.Core">
    <UserControl.Resources>
        <Style x:Key="AddressSquareButton" TargetType="Button">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddressSquare" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBoundary}" Value="True">
                    <Setter Property="Background" Value="#1B2533" />
                    <Setter Property="BorderBrush" Value="#334155" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:IpStatus.Assigned}">
                    <Setter Property="Background" Value="#22C55E" />
                    <Setter Property="BorderBrush" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DeviceStatus}" Value="{x:Static core:DeviceStatus.Offline}">
                    <Setter Property="Background" Value="#334155" />
                    <Setter Property="BorderBrush" Value="#64748B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:IpStatus.Gateway}">
                    <Setter Property="Background" Value="#38BDF8" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:IpStatus.Reserved}">
                    <Setter Property="Background" Value="#A78BFA" />
                    <Setter Property="BorderBrush" Value="#A78BFA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:IpStatus.Conflict}">
                    <Setter Property="Background" Value="#EF4444" />
                    <Setter Property="BorderBrush" Value="#EF4444" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static core:IpStatus.Excluded}">
                    <Setter Property="Background" Value="#475569" />
                    <Setter Property="BorderBrush" Value="#475569" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#F8FAFC" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MapLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="11,6" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Local network IP map" Style="{StaticResource SectionHeader}" Margin="0" />
                    <TextBlock Text="256 squares for the selected /24. Squares are coloured from documented address entries and live discovery results."
                               Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding MapNotice}" Foreground="{DynamicResource WarningBrush}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding MapNotice, Converter={StaticResource EmptyToVisibility}}" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Subnets}" SelectedItem="{Binding SelectedSubnet, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Select the subnet to map">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                <TextBlock Text="{Binding Cidr}" Style="{StaticResource MutedText}" FontSize="11" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <Border Style="{StaticResource CardTight}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="{Binding UsedCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource SuccessBrush}" />
                    <TextBlock Style="{StaticResource MetricLabel}">
                        <Run Text="Used · " /><Run Text="{Binding UsedPercent, Mode=OneWay, StringFormat='{}{0:0.0}%'}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardTight}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="{Binding AvailableCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Available" Style="{StaticResource MetricLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardTight}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="{Binding GatewayAddress}" Style="{StaticResource MetricValue}" FontSize="19" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Gateway" Style="{StaticResource MetricLabel}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardTight}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ConflictCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Text="Conflicts" Style="{StaticResource MetricLabel}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Local Network IP Map" Style="{StaticResource SectionHeader}" Margin="0" />
                            <TextBlock Text="{Binding SubnetCidr}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Text="256 IP addresses (/24)" Style="{StaticResource MutedText}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="28,0,0,2">
                                <ItemsControl ItemsSource="{Binding ColumnLabels}" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource MapLabel}" Width="27" Margin="1,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource MapLabel}" Width="28" />
                                            <ItemsControl ItemsSource="{Binding Cells}" HorizontalAlignment="Left">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="16" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource AddressSquareButton}"
                                                                Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Tooltip}"
                                                                AutomationProperties.Name="{Binding Address}">
                                                            <Border Style="{StaticResource AddressSquare}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding MapNotice}" Foreground="{DynamicResource WarningBrush}" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="28,10,0,0"
                                       Visibility="{Binding MapNotice, Converter={StaticResource EmptyToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Border Width="11" Height="11" CornerRadius="2" Background="#22C55E" VerticalAlignment="Center" />
                            <TextBlock Text="Active" Style="{StaticResource MutedText}" FontSize="10.5" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Border Width="11" Height="11" CornerRadius="2" Background="#334155" VerticalAlignment="Center" />
                            <TextBlock Text="Offline" Style="{StaticResource MutedText}" FontSize="10.5" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource PanelAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                            <TextBlock Text="Available" Style="{StaticResource MutedText}" FontSize="10.5" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Border Width="11" Height="11" CornerRadius="2" Background="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock Text="Gateway" Style="{StaticResource MutedText}" FontSize="10.5" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Border Width="11" Height="11" CornerRadius="2" Background="#A78BFA" VerticalAlignment="Center" />
                            <TextBlock Text="Reserved" Style="{StaticResource MutedText}" FontSize="10.5" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Border Width="11" Height="11" CornerRadius="2" Background="#EF4444" VerticalAlignment="Center" />
                            <TextBlock Text="Conflict" Style="{StaticResource MutedText}" FontSize="10.5" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="11" Height="11" CornerRadius="2" Background="#475569" VerticalAlignment="Center" />
                            <TextBlock Text="Excluded" Style="{StaticResource MutedText}" FontSize="10.5" Margin="5,0,0,0" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Network details" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Network" Style="{StaticResource MutedText}" />
                            <TextBlock Grid.Column="1" Text="{Binding NetworkName}" Style="{StaticResource DetailValue}" />
                            <TextBlock Grid.Row="1" Text="Subnet" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubnetCidr}" Style="{StaticResource DetailValue}" Margin="8,4,0,0" />
                            <TextBlock Grid.Row="2" Text="Gateway" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GatewayAddress}" Style="{StaticResource DetailValue}" Margin="8,4,0,0" />
                            <TextBlock Grid.Row="3" Text="DNS" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DnsServers}" Style="{StaticResource DetailValue}" Margin="8,4,0,0" />
                            <TextBlock Grid.Row="4" Text="Location" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LocationText}" Style="{StaticResource DetailValue}" Margin="8,4,0,0" />
                            <TextBlock Grid.Row="5" Text="Range" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding RangeText}" Style="{StaticResource DetailValue}" Margin="8,4,0,0" />
                        </Grid>

                        <Separator Margin="0,10,0,8" />

                        <TextBlock Text="Selected address" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <TextBlock Text="Select a square to inspect an address." Style="{StaticResource MutedText}" FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasSelectedCell, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <StackPanel Visibility="{Binding HasSelectedCell, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedCell.Address, TargetNullValue='—'}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedCell.StatusText, TargetNullValue='—'}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Device" Style="{StaticResource MutedText}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedCell.DeviceName, TargetNullValue='—'}" Style="{StaticResource DetailValue}" />
                                <TextBlock Grid.Row="1" Text="Hostname" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCell.Hostname, TargetNullValue='—'}" Style="{StaticResource DetailValue}" Margin="8,3,0,0" />
                                <TextBlock Grid.Row="2" Text="MAC" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCell.MacAddress, TargetNullValue='—'}" Style="{StaticResource DetailValue}" Margin="8,3,0,0" />
                            </Grid>
                        </StackPanel>

                        <Separator Margin="0,10,0,8" />

                        <TextBlock Text="Quick actions" Style="{StaticResource SectionHeader}" Margin="0,0,0,7" />
                        <Button Command="{Binding ScanNetworkCommand}" Style="{StaticResource ActionButton}" AutomationProperties.Name="Scan network">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Scan network" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ViewActiveDevicesCommand}" Style="{StaticResource ActionButton}" AutomationProperties.Name="View active devices">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="View active devices" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CheckConflictsCommand}" Style="{StaticResource ActionButton}" AutomationProperties.Name="Check IP conflicts">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Check IP conflicts" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportResultsCommand}" Style="{StaticResource ActionButton}" AutomationProperties.Name="Export results">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Export results" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Last updated" Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource MutedText}" FontSize="10.5" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
