<UserControl x:Class="IPManager.App.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}"
                          Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Filter title, message, address or type" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox Content="Include acknowledged" IsChecked="{Binding IncludeAcknowledged}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Clear" Command="{Binding ClearFilterCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0"
                               Text="Alerts are local. Acknowledging keeps the record; purge removes alerts older than the retention setting." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding CriticalCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" /><TextBlock Text="critical" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding WarningCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" /><TextBlock Text="warning" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding InfoCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" /><TextBlock Text="info" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding UnreadCount}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="unread" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <Button Content="Mark all read" Command="{Binding MarkAllReadCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Acknowledge all" Command="{Binding AcknowledgeAllCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Purge old" Command="{Binding PurgeCommand}" Style="{StaticResource DangerButton}" Padding="10,4" MinHeight="26" FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding VisibleAlerts}" SelectedItem="{Binding SelectedAlert, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding CreatedAt, Converter={StaticResource UtcToLocal}}" Width="120" />
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="70">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Foreground" Value="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type, Converter={StaticResource EnumText}}" Width="100" />
                        <DataGridTextColumn Header="Address" Binding="{Binding IpAddress}" Width="110" />
                        <DataGridTextColumn Header="Ack" Binding="{Binding IsAcknowledged, Converter={StaticResource BoolToText}}" Width="45" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Alert detail" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding SelectedAlert.Title, TargetNullValue='No alert selected'}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="9" Padding="7,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding SelectedAlert.Severity}" FontSize="10.5"
                                           Foreground="{Binding SelectedAlert.Severity, Converter={StaticResource SeverityBrush}}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedAlert.CreatedAt, Converter={StaticResource UtcToLocal}}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedAlert.Message}" TextWrapping="Wrap" FontSize="12" />
                        <Separator />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Type" Style="{StaticResource MutedText}" Margin="0,2" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedAlert.Type, Converter={StaticResource EnumText}}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Text="Address" Style="{StaticResource MutedText}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAlert.IpAddress}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Text="Entity" Style="{StaticResource MutedText}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,2">
                                <Run Text="{Binding SelectedAlert.EntityType, Mode=OneWay}" /><Run Text=" #" /><Run Text="{Binding SelectedAlert.EntityId, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Row="3" Text="Acknowledged" Style="{StaticResource MutedText}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAlert.IsAcknowledged, Converter={StaticResource BoolToText}, ConverterParameter='Yes|No'}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Text="Recovered" Style="{StaticResource MutedText}" Margin="0,2" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedAlert.IsRecovered, Converter={StaticResource BoolToText}, ConverterParameter='Yes|No'}" Margin="0,2" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Toggle acknowledge" Command="{Binding AcknowledgeCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                            <Button Content="Open source" Command="{Binding OpenSourceCommand}" Style="{StaticResource SmallButton}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Text="Email and Telegram delivery are optional and configured on the Settings page. No alert content leaves this computer unless you enable a channel." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
