<UserControl x:Class="IPManager.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Host or IP address" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="Count" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PingCount, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,6,0">
                    <TextBlock Text="Interval ms" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding PingInterval, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,6,0">
                    <TextBlock Text="Timeout ms" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="TCP port" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Ping" Command="{Binding PingCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                    <Button Content="Trace" Command="{Binding TracerouteCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Port" Command="{Binding PortCheckCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="ARP" Command="{Binding ReadArpCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" IsEnabled="{Binding IsRunning}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.1*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.9*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardTight}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Operations" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding ActiveOperation}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Use gateway" Command="{Binding UseGatewayCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                            <Button Content="Use this PC" Command="{Binding UseAdapterAddressCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                            <Button Content="Use DNS server" Command="{Binding UseDnsServerCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                            <Button Content="Reload adapters" Command="{Binding RefreshAdaptersCommand}" Style="{StaticResource SmallButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="0,0,0,4">
                    <TextBlock Text="{Binding PingSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PortSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Ping results" Style="{StaticResource SectionHeader}" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding PingResults}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Result" Binding="{Binding Success, Converter={StaticResource BoolToText}, ConverterParameter='Reply|No reply'}" Width="80" />
                                <DataGridTextColumn Header="Roundtrip" Binding="{Binding RoundtripMs, StringFormat='{}{0} ms'}" Width="85" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="3" Text="{Binding TracerouteSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,4" />
                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Traceroute" Style="{StaticResource SectionHeader}" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding TracerouteHops}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hop" Binding="{Binding Hop}" Width="45" />
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="140" />
                                <DataGridTextColumn Header="Roundtrip" Binding="{Binding RoundtripMs, StringFormat='{}{0} ms'}" Width="85" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.15*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0.85*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding AdapterSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Network adapters" Style="{StaticResource SectionHeader}" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Adapters}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="IPv4" Binding="{Binding Address}" Width="115" />
                                <DataGridTextColumn Header="CIDR" Binding="{Binding Cidr}" Width="115" />
                                <DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="115" />
                                <DataGridTextColumn Header="DNS" Binding="{Binding Dns}" Width="160" />
                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" Text="{Binding ArpSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,4" />
                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="ARP / neighbor cache" Style="{StaticResource SectionHeader}" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ArpEntries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="135" />
                                <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="150" />
                                <DataGridTextColumn Header="Type" Binding="{Binding IsStatic, Converter={StaticResource BoolToText}, ConverterParameter='Static|Dynamic'}" Width="70" />
                                <DataGridTextColumn Header="Interface" Binding="{Binding InterfaceAddress}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
