<UserControl x:Class="IPManager.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,8,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Search name, IP, MAC, host, vendor, tag or location" IsHitTestVisible="False"
                               Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="New device" Command="{Binding AddDeviceCommand}" Style="{StaticResource AccentButton}" Padding="10,4" MinHeight="26" FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding VisibleDevices.Count, StringFormat='{}{0} devices'}" Style="{StaticResource SectionHeader}" Margin="0" />
                            <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="9" Padding="7,2" Margin="10,0,0,0">
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource SuccessBrush}">
                                    <Run Text="{Binding OnlineCount, Mode=OneWay}" /><Run Text=" online" />
                                </TextBlock>
                            </Border>
                            <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="9" Padding="7,2" Margin="6,0,0,0">
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource DangerBrush}">
                                    <Run Text="{Binding OfflineCount, Mode=OneWay}" /><Run Text=" offline" />
                                </TextBlock>
                            </Border>
                            <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="9" Padding="7,2" Margin="6,0,0,0">
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding UnknownCount, Mode=OneWay}" /><Run Text=" unknown" />
                                </TextBlock>
                            </Border>
                            <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="9" Padding="7,2" Margin="6,0,0,0">
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding TrustedCount, Mode=OneWay}" /><Run Text=" trusted" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleDevices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="118" />
                            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="132" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category, Converter={StaticResource EnumText}}" Width="104" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="74" />
                            <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="130" />
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen, Converter={StaticResource UtcToLocal}}" Width="132" />
                            <DataGridTextColumn Header="Trusted" Binding="{Binding IsTrusted, Converter={StaticResource BoolToText}}" Width="62" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="390" Style="{StaticResource Card}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionHeader}" Margin="0" />
                            <Button Content="Close" Command="{Binding CancelEditCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedDevice.Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="IP address" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding SelectedDevice.IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="MAC address" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding SelectedDevice.MacAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Hostname" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding SelectedDevice.Hostname, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Manufacturer / vendor" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding SelectedDevice.Manufacturer, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Operating system" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding SelectedDevice.OperatingSystem, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding CategoryValues}" SelectedItem="{Binding SelectedDevice.Category, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumText}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding StatusValues}" SelectedItem="{Binding SelectedDevice.Status, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Subnet" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding Subnets}" SelectedValue="{Binding SelectedDevice.SubnetId, Mode=TwoWay}"
                                  SelectedValuePath="Id">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cidr}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Location" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding SelectedDevice.Location, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Tags" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding SelectedDevice.Tags, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding SelectedDevice.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="64" VerticalContentAlignment="Top" />

                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="Trusted" IsChecked="{Binding SelectedDevice.IsTrusted}" Margin="0,0,14,4" />
                            <CheckBox Content="Important" IsChecked="{Binding SelectedDevice.IsImportant}" Margin="0,0,14,4" />
                            <CheckBox Content="Exclude from monitoring" IsChecked="{Binding SelectedDevice.ExcludeFromMonitoring}" Margin="0,0,14,4" />
                            <CheckBox Content="Manually managed" IsChecked="{Binding SelectedDevice.IsManuallyManaged}" Margin="0,0,14,4" />
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" />
                            <Button Content="Monitoring" Command="{Binding OpenMonitoringCommand}" Style="{StaticResource SmallButton}" />
                        </StackPanel>

                        <Separator />
                        <TextBlock Text="Change history" Style="{StaticResource FieldLabel}" />
                        <DataGrid ItemsSource="{Binding History}" Height="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Field" Binding="{Binding Field}" Width="90" />
                                <DataGridTextColumn Header="Old" Binding="{Binding OldValue}" Width="*" />
                                <DataGridTextColumn Header="New" Binding="{Binding NewValue}" Width="*" />
                                <DataGridTextColumn Header="When" Binding="{Binding ChangedAt, Converter={StaticResource UtcToLocal}}" Width="128" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
