<UserControl x:Class="IPManager.App.Views.DiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Adapter" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                    <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding Ipv4Address, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding SuggestedCidr, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding IsUp, Converter={StaticResource BoolToText}, ConverterParameter='Up|Down'}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Use this adapter" Command="{Binding UseInterfaceCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                        <Button Content="Reload adapters" Command="{Binding ReloadInterfacesCommand}" Style="{StaticResource SmallButton}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Targets (one per line, comma separated, IP, range or CIDR)" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Targets, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="66" VerticalContentAlignment="Top" />
                    <WrapPanel Margin="0,6,0,0">
                        <CheckBox Content="ARP / neighbor cache" IsChecked="{Binding EnableArp}" Margin="0,0,12,0" />
                        <CheckBox Content="ICMP" IsChecked="{Binding EnableIcmp}" Margin="0,0,12,0" />
                        <CheckBox Content="TCP ports" IsChecked="{Binding EnableTcp}" Margin="0,0,12,0" />
                        <CheckBox Content="Reverse DNS" IsChecked="{Binding EnableDns}" Margin="0,0,12,0" />
                        <CheckBox Content="mDNS" IsChecked="{Binding EnableMdns}" Margin="0,0,12,0" />
                        <CheckBox Content="NetBIOS" IsChecked="{Binding EnableNetBios}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="205">
                    <Button Content="Start discovery" Command="{Binding ScanCommand}" Style="{StaticResource AccentButton}" Height="38"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />
                    <Button Content="Cancel scan" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="0,6,0,0"
                            IsEnabled="{Binding IsScanning}" />
                    <CheckBox Content="Allow public ranges" IsChecked="{Binding AllowExternal}" Margin="0,8,0,0"
                              ToolTip="Private LAN ranges are scanned by default. Public ranges need this confirmation and can be intrusive." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                        <Run Text="{Binding CheckedCount, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" />
                        <Run Text=" checked · " />
                        <Run Text="{Binding FoundCount, Mode=OneWay}" />
                        <Run Text=" found" />
                    </TextBlock>
                </Grid>
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Margin="0,7,0,0" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Warnings}" Foreground="{DynamicResource WarningBrush}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Warnings, Converter={StaticResource EmptyToVisibility}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Discovery results" Style="{StaticResource SectionHeader}" />
                        <Button Content="Copy results" Command="{Binding CopyResultsCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedHost, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP address" Binding="{Binding IpAddress}" Width="120" />
                            <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="135" />
                            <DataGridTextColumn Header="Name" Binding="{Binding BestName}" Width="150" />
                            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="*" />
                            <DataGridTextColumn Header="Evidence" Binding="{Binding SourceText}" Width="150" />
                            <DataGridTextColumn Header="Ports" Binding="{Binding OpenPortsText}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Selection" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding SelectedHost.IpAddress, TargetNullValue='No host selected'}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedHost.BestName}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding SelectedHost.EvidenceText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Separator />
                    <TextBlock Text="Open TCP ports" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedHost.OpenPortsText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                    <TextBlock Text="Response" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding SelectedHost.ResponseMs, StringFormat='{}{0:0} ms', TargetNullValue='no timing'}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="A device is never marked offline from a failed ping alone. An ARP-only result can be a stale neighbour entry and never confirms a conflict." 
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
