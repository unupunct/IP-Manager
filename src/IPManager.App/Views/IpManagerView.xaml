<UserControl x:Class="IPManager.App.Views.IpManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Subnets}" SelectedItem="{Binding SelectedSubnet, Mode=TwoWay}" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                <TextBlock Text="{Binding Cidr, StringFormat=' · {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                          Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Grid.Column="2" Margin="0,0,8,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Filter address, device, MAC, hostname or description" IsHitTestVisible="False" Margin="11,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Find free" Command="{Binding FindFreeCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Reserve / assign" Command="{Binding AddAddressCommand}" Style="{StaticResource AccentButton}" Padding="10,4" MinHeight="26" FontSize="11.5" Margin="0,0,6,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SubnetSummary}" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Truncated, Converter={StaticResource BoolToText}, ConverterParameter='Display limited to the first 4096 rows (the subnet is larger).|Full address map loaded.'}"
                               Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding TotalHosts}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="total" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding AssignedCount}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" /><TextBlock Text="assigned" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding ReservedCount}" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA" /><TextBlock Text="reserved" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding AvailableCount}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="available" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding ConflictCount}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" /><TextBlock Text="conflict" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,14,0"><TextBlock Text="{Binding ExcludedCount}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="excluded" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel><TextBlock Text="{Binding UtilizationPercent, StringFormat='{}{0:0.0}%'}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="utilization" Style="{StaticResource MetricLabel}" /></StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="118" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="82">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource IpStatusBrush}}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Allocation" Binding="{Binding Allocation}" Width="88" />
                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="*" />
                        <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="132" />
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="130" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="160" />
                        <DataGridTextColumn Header="DHCP" Binding="{Binding InDhcpRange, Converter={StaticResource BoolToText}, ConverterParameter='pool|static'}" Width="58" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="92" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Width="350" Style="{StaticResource Card}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionHeader}" Margin="0" />
                            <Button Content="Close" Command="{Binding CancelEditorCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Address" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EditingAddress.Address, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsNewEntry, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="Hostname" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding EditingAddress.Hostname, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="MAC address" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding EditingAddress.MacAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                                <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding StatusValues}" SelectedItem="{Binding EditingAddress.Status, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Allocation" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding AllocationValues}" SelectedItem="{Binding EditingAddress.AllocationType, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding EditingAddress.Description, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding EditingAddress.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="70" VerticalContentAlignment="Top" />
                        <CheckBox Content="Manually managed (protect from automatic updates)" IsChecked="{Binding EditingAddress.IsManuallyManaged}" Margin="0,10,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save" Command="{Binding SaveEntryCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                            <Button Content="Release" Command="{Binding ReleaseEntryCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" />
                            <Button Content="Device" Command="{Binding OpenDeviceCommand}" Style="{StaticResource SmallButton}" />
                        </StackPanel>
                        <TextBlock Text="Conflicts are evidence-based. A database duplicate is not the same as two live devices answering for one address." 
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
