<UserControl x:Class="IPManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Last updated" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource MutedText}" Margin="6,0,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Discovery" Command="{Binding GoDiscoveryCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Conflicts" Command="{Binding GoConflictsCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Alerts" Command="{Binding GoAlertsCommand}" Style="{StaticResource AccentButton}" Padding="10,4" MinHeight="26" FontSize="11.5" />
                </StackPanel>
            </Grid>

            <UniformGrid Columns="5" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding SubnetCount}" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Managed subnets" Style="{StaticResource MetricLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DeviceCount}" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Devices" Style="{StaticResource MetricLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding OnlineDevices}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="Online now" Style="{StaticResource MetricLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveConflicts}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="Active conflicts" Style="{StaticResource MetricLabel}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding AvailableAddresses}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Available addresses" Style="{StaticResource MetricLabel}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Address allocation" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Allocation}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="122" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource PanelAltBrush}" VerticalAlignment="Center">
                                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="Device status" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding DeviceStatus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="122" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource PanelAltBrush}" VerticalAlignment="Center">
                                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource SuccessBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator />
                        <TextBlock Text="{Binding OnlinePercent, StringFormat='{}{0:0.0}% of known devices online'}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Subnet utilization" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding SubnetUtilization}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="122" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource PanelAltBrush}" VerticalAlignment="Center">
                                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource InfoBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Recently seen devices" Style="{StaticResource SectionHeader}" />
                            <Button Content="Open devices" Command="{Binding GoDevicesCommand}" Style="{StaticResource LinkButton}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding RecentDevices}" Height="210" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Address" Binding="{Binding IpAddress}" Width="120" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category, Converter={StaticResource EnumText}}" Width="110" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen, Converter={StaticResource UtcToLocal}}" Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Recent activity" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="4" CornerRadius="2" Background="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" MaxHeight="30" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Timestamp, Converter={StaticResource UtcToLocal}}" Style="{StaticResource MutedText}" FontSize="10.5" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardTight}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasData}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="No network data yet" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,8"
                               Text="Start by running discovery on the Discovery page, or document a subnet on the Subnet Manager page. IP Manager never inserts sample data." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Run discovery" Command="{Binding GoDiscoveryCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                        <Button Content="Add a subnet" Command="{Binding GoSubnetsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
