<UserControl x:Class="IPManager.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding VisibleDevices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                <TextBlock Text="{Binding IpAddress}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <TextBox Text="{Binding DeviceFilter, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Filter devices by name, IP or MAC" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding DeviceFilter, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>
                <ComboBox Grid.Column="2" ItemsSource="{Binding UptimeRanges}" SelectedItem="{Binding SelectedUptimeRange, Mode=TwoWay}"
                          Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Run cycle" Command="{Binding RunCycleCommand}" Style="{StaticResource AccentButton}" Padding="10,4" MinHeight="26" FontSize="11.5" Margin="0,0,6,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="New target" Command="{Binding NewTargetCommand}" Style="{StaticResource SmallButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionHeader}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Missing checks are not counted as downtime. Uptime is calculated only from recorded observations." />
                    <ItemsControl ItemsSource="{Binding Buckets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Height="96" VerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="9" Margin="1,0" VerticalAlignment="Bottom" CornerRadius="2"
                                        Height="{Binding Height}" Background="{DynamicResource AccentBrush}" ToolTip="{Binding Tooltip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Buckets.Count, StringFormat='{}{0} observation buckets'}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding UptimeText}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="uptime" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding TotalChecks}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="checks" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding SuccessfulChecks}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="successful" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel Margin="0,0,18,0"><TextBlock Text="{Binding FailedChecks}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" /><TextBlock Text="failed" Style="{StaticResource MetricLabel}" /></StackPanel>
                    <StackPanel><TextBlock Text="{Binding AverageResponse, StringFormat='{}{0:0} ms'}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="average response" Style="{StaticResource MetricLabel}" /></StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Observation history" Style="{StaticResource SectionHeader}" />
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                            <Run Text="Last check: " /><Run Text="{Binding LastCheckText, Mode=OneWay}" />
                            <Run Text=" · last success: " /><Run Text="{Binding LastSuccessText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding History}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding Timestamp, Converter={StaticResource UtcToLocal}}" Width="145" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Success, Converter={StaticResource BoolToText}, ConverterParameter='Online|Failed'}" Width="80" />
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="75" />
                            <DataGridTextColumn Header="Response" Binding="{Binding ResponseMs, StringFormat='{}{0:0} ms'}" Width="90" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Width="390" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Monitoring targets" Style="{StaticResource SectionHeader}" />
                        <DataGrid ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" Height="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="75" />
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="55" />
                                <DataGridTextColumn Header="Interval" Binding="{Binding IntervalSeconds}" Width="65" />
                                <DataGridTextColumn Header="Enabled" Binding="{Binding Enabled, Converter={StaticResource BoolToText}}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource CardTight}" Margin="0,8,0,0"
                                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Method" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod, Mode=TwoWay}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="TCP port (for TCP)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TargetPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="HTTP URL (for HTTP)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TargetUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="Interval seconds" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TargetInterval, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Timeout ms" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding TargetTimeout, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="Target enabled" IsChecked="{Binding TargetEnabled}" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Save target" Command="{Binding SaveTargetCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                                    <Button Content="Delete" Command="{Binding DeleteTargetCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" />
                                    <Button Content="Close" Command="{Binding CancelEditorCommand}" Style="{StaticResource SmallButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="The background monitor honours the interval, timeout and retention settings on the Settings page. Manual cycles are available above." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
