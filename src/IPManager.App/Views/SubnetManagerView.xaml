<UserControl x:Class="IPManager.App.Views.SubnetManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalHosts, StringFormat=' · {0:N0} hosts documented'}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface, Mode=TwoWay}" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Add from adapter" Command="{Binding AddFromAdapterCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="New subnet" Command="{Binding NewSubnetCommand}" Style="{StaticResource AccentButton}" Padding="10,4" MinHeight="26" FontSize="11.5" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Subnet.Name}" Width="1.3*" MinWidth="90" />
                        <DataGridTextColumn Header="CIDR" Binding="{Binding Subnet.Cidr}" Width="0.9*" MinWidth="80" />
                        <DataGridTextColumn Header="Gateway" Binding="{Binding Subnet.Gateway}" Width="0.85*" MinWidth="80" />
                        <DataGridTextColumn Header="Used" Binding="{Binding UsedText}" Width="0.55*" MinWidth="50" />
                        <DataGridTemplateColumn Header="Utilization" Width="1.05*" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Border Height="7" CornerRadius="3" Background="{DynamicResource PanelAltBrush}">
                                            <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding Percent, StringFormat='{}{0:0.0}%'}" FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,12" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DHCP range" Binding="{Binding Subnet.DhcpStart}" Width="0.95*" MinWidth="85" />
                        <DataGridTextColumn Header="Location" Binding="{Binding Subnet.Location}" Width="0.85*" MinWidth="75" />
                        <DataGridTextColumn Header="Warnings" Binding="{Binding WarningsText}" Width="1.4*" MinWidth="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Width="390" Style="{StaticResource Card}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionHeader}" Margin="0" />
                            <Button Content="Close" Command="{Binding CancelEditorCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding EditorSubnet.Name, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Network address" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditorSubnet.NetworkAddress, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditorSubnet.PrefixLength, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="VLAN" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EditorSubnet.VlanId, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Gateway" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding EditorSubnet.Gateway, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="DNS servers" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding EditorSubnet.DnsServers, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Location" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding EditorSubnet.Location, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="DHCP pool start / end" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EditorSubnet.DhcpStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1" Text="{Binding EditorSubnet.DhcpEnd, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0" />
                        </Grid>
                        <TextBlock Text="Static range start / end" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EditorSubnet.StaticStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1" Text="{Binding EditorSubnet.StaticEnd, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0" />
                        </Grid>
                        <TextBlock Text="Excluded addresses (comma separated)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding EditorSubnet.ExcludedAddresses, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                        <TextBox Text="{Binding EditorSubnet.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="60" VerticalContentAlignment="Top" />
                        <CheckBox Content="Enable monitoring for this subnet" IsChecked="{Binding EditorSubnet.MonitoringEnabled}" Margin="0,10,0,0" />
                        <CheckBox Content="Auto-discovered" IsChecked="{Binding EditorSubnet.IsAutoDiscovered}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding EditorWarnings}" Foreground="{DynamicResource WarningBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding EditorWarnings, Converter={StaticResource EmptyToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                            <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" />
                            <Button Content="Address map" Command="{Binding OpenAddressMapCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                            <Button Content="DHCP" Command="{Binding OpenDhcpCommand}" Style="{StaticResource SmallButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
