<UserControl x:Class="IPManager.App.Views.SubnetCalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,7,10">
                    <StackPanel>
                        <TextBlock Text="IPv4 subnet calculator" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="IPv4 address or CIDR" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding PrefixOptions}" SelectedItem="{Binding PrefixLength, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <Button Content="Calculate" Command="{Binding CalculateCommand}" Style="{StaticResource AccentButton}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding ValidationMessage, Converter={StaticResource EmptyToVisibility}}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="CIDR" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Calculation.Cidr}" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock Grid.Row="1" Text="Network" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Calculation.NetworkAddress}" Margin="0,3" />
                            <TextBlock Grid.Row="2" Text="Broadcast" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Calculation.BroadcastAddress}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Text="Subnet mask" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Calculation.SubnetMask}" Margin="0,3" />
                            <TextBlock Grid.Row="4" Text="Wildcard" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Calculation.WildcardMask}" Margin="0,3" />
                            <TextBlock Grid.Row="5" Text="First usable" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Calculation.FirstUsable}" Margin="0,3" />
                            <TextBlock Grid.Row="6" Text="Last usable" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Calculation.LastUsable}" Margin="0,3" />
                            <TextBlock Grid.Row="7" Text="Total addresses" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Calculation.TotalAddresses, StringFormat='{}{0:N0}'}" Margin="0,3" />
                            <TextBlock Grid.Row="8" Text="Usable hosts" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Calculation.UsableHosts, StringFormat='{}{0:N0}'}" Margin="0,3" />
                            <TextBlock Grid.Row="9" Text="Legacy class" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Calculation.LegacyClass}" Margin="0,3" />
                            <TextBlock Grid.Row="10" Text="Binary address" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Calculation.BinaryAddress}" FontFamily="Consolas" FontSize="11" Margin="0,3" TextWrapping="Wrap" />
                        </Grid>
                        <Button Content="Copy summary" Command="{Binding CopySummaryCommand}" Style="{StaticResource SmallButton}"
                                HorizontalAlignment="Left" Margin="0,10,0,0" />

                        <Separator />
                        <TextBlock Text="Divide into equal subnets" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DivisionCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Divide" Command="{Binding DivideCommand}" Style="{StaticResource SmallButton}" />
                        </Grid>
                        <TextBlock Text="{Binding ActualDivisionCount, StringFormat='{}{0} subnet(s) shown'}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        <DataGrid ItemsSource="{Binding Division}" Height="210" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                                <DataGridTextColumn Header="CIDR" Binding="{Binding Cidr}" Width="115" />
                                <DataGridTextColumn Header="Mask" Binding="{Binding Mask}" Width="115" />
                                <DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="*" />
                                <DataGridTextColumn Header="Usable" Binding="{Binding UsableHosts, StringFormat='{}{0:N0}'}" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,10">
                    <StackPanel>
                        <TextBlock Text="IPv6 calculator" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="IPv6 address" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Ipv6Address, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Prefix" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Ipv6Prefix, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <Button Content="Calculate" Command="{Binding CalculateIpv6Command}" Style="{StaticResource AccentButton}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Ipv6Error}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Ipv6Error, Converter={StaticResource EmptyToVisibility}}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Network" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Ipv6Network}" FontFamily="Consolas" FontSize="12" Margin="0,3" />
                            <TextBlock Grid.Row="1" Text="Address type" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Ipv6Type}" Margin="0,3" />
                            <TextBlock Grid.Row="2" Text="Total addresses" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Ipv6Total}" Margin="0,3" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Text="Usable hosts" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Ipv6Usable}" Margin="0,3" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="4" Text="Binary" Style="{StaticResource MutedText}" Margin="0,3" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Ipv6Binary}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,3" />
                        </Grid>
                        <Separator />
                        <TextBlock Text="Divide into a new prefix" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Ipv6NewPrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Divide" Command="{Binding DivideIpv6Command}" Style="{StaticResource SmallButton}" />
                        </Grid>
                        <TextBlock Text="{Binding Ipv6DivisionMessage}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <ListBox ItemsSource="{Binding Ipv6Subnets}" Height="210" Margin="0,6,0,0" Background="{DynamicResource InputBackgroundBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Margin="3" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Text="Subnet math is performed locally. The /31 and /32 host-count conventions are documented in the NETWORK_DISCOVERY and USER_GUIDE sections." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
