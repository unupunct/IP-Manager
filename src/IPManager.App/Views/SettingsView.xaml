<UserControl x:Class="IPManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Application settings" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                               Text="Settings are stored in the local database. Secrets are protected with Windows DPAPI for the current user." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                    <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
                                <CheckBox Content="Dark theme" IsChecked="{Binding IsDarkTheme}" Margin="0,2,0,6" />
                                <CheckBox Content="Use a 24-hour clock in the interface" IsChecked="{Binding Use24HourClock}" Margin="0,2,0,6" />
                                <TextBlock Text="UI refresh interval (seconds)" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
                                <TextBox Text="{Binding UiRefreshSeconds, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" />
                                <Button Content="Reset to dark theme" Command="{Binding ResetThemeCommand}" Style="{StaticResource SmallButton}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="About and data location" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="Version" Style="{StaticResource MutedText}" Margin="0,3" />
                                    <TextBlock Grid.Column="1" Text="{Binding VersionText}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Text="Data directory" Style="{StaticResource MutedText}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataDirectory}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Database" Style="{StaticResource MutedText}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DatabasePath}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="3" Text="Logs" Style="{StaticResource MutedText}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LogDirectory}" Margin="0,3" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Text="{Binding StorageSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                                    <Button Content="Change data folder" Command="{Binding ChangeDataDirectoryCommand}" Style="{StaticResource SmallButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Discovery">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Defaults" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="Default target range" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding DefaultScanRange, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Preferred adapter (name or address, optional)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                <TextBox Text="{Binding PreferredInterface, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Timeout ms" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ScanTimeoutMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0"><TextBlock Text="Concurrency" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ScanConcurrency, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="Retries" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ScanRetryCount, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Delay between probes (ms)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ScanDelayMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Maximum addresses per scan" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding MaxAddressesPerScan, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Methods" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <CheckBox Content="ARP / neighbor cache" IsChecked="{Binding EnableArp}" Margin="0,0,18,6" />
                                    <CheckBox Content="ICMP echo" IsChecked="{Binding EnableIcmp}" Margin="0,0,18,6" />
                                    <CheckBox Content="TCP probes" IsChecked="{Binding EnableTcp}" Margin="0,0,18,6" />
                                    <CheckBox Content="DNS" IsChecked="{Binding EnableDns}" Margin="0,0,18,6" />
                                    <CheckBox Content="Reverse DNS" IsChecked="{Binding EnableReverseDns}" Margin="0,0,18,6" />
                                    <CheckBox Content="mDNS" IsChecked="{Binding EnableMdns}" Margin="0,0,18,6" />
                                    <CheckBox Content="NetBIOS" IsChecked="{Binding EnableNetBios}" Margin="0,0,18,6" />
                                </WrapPanel>
                                <TextBlock Text="TCP probe ports (comma separated)" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                                <TextBox Text="{Binding TcpProbePorts, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Require confirmation before scanning external / public ranges" IsChecked="{Binding RequireConfirmationForExternalRanges}" Margin="0,10,0,4" />
                                <CheckBox Content="Run a discovery scan automatically when the app starts" IsChecked="{Binding AutoScanOnStartup}" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="Private IPv4 ranges are allowed by default. Public and third-party ranges require an explicit confirmation and are never scanned silently." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Monitoring">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Availability monitoring" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Interval seconds" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding MonitoringIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Offline threshold minutes" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding OfflineThresholdMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Timeout ms" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding MonitoringTimeoutMs, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Retention days" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding MonitoringRetentionDays, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </Grid>
                                <CheckBox Content="Monitor the default gateway" IsChecked="{Binding MonitorGateway}" Margin="0,10,0,4" />
                                <CheckBox Content="Persist monitoring results to the database" IsChecked="{Binding PersistMonitoringResults}" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="A failed ping is not enough to declare a device offline. The monitor combines the configured methods and the offline threshold before raising an alert." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Conflicts &amp; alerts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Conflict evidence" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Fresh evidence window (minutes)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ConflictFreshMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Stale evidence window (hours)" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding ConflictStaleHours, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="A live conflict is confirmed only by multiple fresh MAC observations for the same address. Stale ARP entries never confirm a conflict." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Thresholds and cooldown" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Subnet utilization %" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding SubnetUtilizationThreshold, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0"><TextBlock Text="DHCP exhaustion %" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding DhcpExhaustionThreshold, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0"><TextBlock Text="Alert cooldown minutes" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding AlertCooldownMinutes, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Raise alerts for" Style="{StaticResource SectionHeader}" />
                                <WrapPanel>
                                    <CheckBox Content="New devices" IsChecked="{Binding AlertOnNewDevices}" Margin="0,0,18,6" />
                                    <CheckBox Content="Unknown devices" IsChecked="{Binding AlertOnUnknownDevices}" Margin="0,0,18,6" />
                                    <CheckBox Content="Devices going offline" IsChecked="{Binding AlertOnDeviceOffline}" Margin="0,0,18,6" />
                                    <CheckBox Content="IP conflicts" IsChecked="{Binding AlertOnConflicts}" Margin="0,0,18,6" />
                                    <CheckBox Content="Recovery notifications" IsChecked="{Binding RecoveryNotifications}" Margin="0,0,18,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Notifications">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="In-app alerts" Style="{StaticResource SectionHeader}" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Alerts are always recorded in the Alerts page. Email and Telegram are optional outbound channels and are disabled by default." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Telegram" Style="{StaticResource SectionHeader}" />
                                <CheckBox Content="Enable Telegram notifications" IsChecked="{Binding TelegramEnabled}" Margin="0,0,0,6" />
                                <TextBlock Text="Chat ID" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding TelegramChatId, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Bot token (leave blank to keep the existing token)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                <PasswordBox x:Name="TelegramTokenBox" PasswordChanged="OnTelegramSecretChanged" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Text="{Binding TelegramTokenConfigured, StringFormat='Token configured: {0}'}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Email (SMTP)" Style="{StaticResource SectionHeader}" />
                                <CheckBox Content="Enable email notifications" IsChecked="{Binding EmailEnabled}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="SMTP host" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding EmailSmtpHost, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Port" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding EmailSmtpPort, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="From address" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding EmailFrom, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="To address" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                </Grid>
                                <TextBlock Text="SMTP username" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                <TextBox Text="{Binding EmailUsername, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="SMTP password (leave blank to keep the existing password)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                                <PasswordBox x:Name="EmailPasswordBox" PasswordChanged="OnEmailSecretChanged" />
                                <CheckBox Content="Use TLS / STARTTLS" IsChecked="{Binding EmailUseTls}" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                           Text="{Binding EmailPasswordConfigured, StringFormat='Password configured: {0}'}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Storage &amp; maintenance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Retention" Style="{StaticResource SectionHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Backups" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding BackupRetentionCount, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0"><TextBlock Text="Alert days" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding AlertRetentionDays, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="3,0"><TextBlock Text="Audit days" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding AuditRetentionDays, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    <StackPanel Grid.Column="3" Margin="6,0,0,0"><TextBlock Text="Log level" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel, Mode=TwoWay}" /></StackPanel>
                                </Grid>
                                <CheckBox Content="Create a backup when the application starts" IsChecked="{Binding BackupOnStartup}" Margin="0,10,0,4" />
                                <CheckBox Content="Confirm before changing a remote DNS record" IsChecked="{Binding ConfirmBeforeRemoteChanges}" Margin="0,0,0,4" />
                                <CheckBox Content="Start IP Manager with Windows (current user; no Windows service)" IsChecked="{Binding StartWithWindows}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Backups" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Text="{Binding BackupSummary}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}" Height="160">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedUtc, Converter={StaticResource UtcToLocal}}" Width="145" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Create backup" Command="{Binding CreateBackupCommand}" Style="{StaticResource AccentButton}" Padding="10,4" MinHeight="26" FontSize="11.5" Margin="0,0,6,6" />
                                    <Button Content="Restore selected" Command="{Binding RestoreBackupCommand}" Style="{StaticResource DangerButton}" Padding="10,4" MinHeight="26" FontSize="11.5" Margin="0,0,6,6" />
                                    <Button Content="Prune" Command="{Binding PruneBackupsCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,6" />
                                    <Button Content="Export data package" Command="{Binding ExportPackageCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,6" />
                                    <Button Content="Open backup folder" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,6" />
                                    <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Maintenance and OUI data" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding MaintenanceSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Run retention cleanup" Command="{Binding RunMaintenanceCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                                    <Button Content="Open export folder" Command="{Binding OpenExportFolderCommand}" Style="{StaticResource SmallButton}" />
                                </StackPanel>
                                <Separator />
                                <TextBlock Text="OUI registry" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding OuiUpdateUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{Binding OuiSummary}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Update from IEEE" Command="{Binding UpdateOuiCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                                    <Button Content="Import CSV" Command="{Binding ImportOuiCommand}" Style="{StaticResource SmallButton}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
