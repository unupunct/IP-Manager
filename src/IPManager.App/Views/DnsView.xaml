<UserControl x:Class="IPManager.App.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabItem Header="Lookup">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="200" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardTight}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding QueryName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                 ToolTip="Hostname or IP address; press Enter to look up" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RecordTypes}" SelectedItem="{Binding SelectedRecordType, Mode=TwoWay}" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}" Margin="0,0,8,0"
                                  ToolTip="System default or a detected DNS server" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="Lookup" Command="{Binding LookupCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                            <Button Content="Reverse" Command="{Binding ReverseCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="Answers" Style="{StaticResource SectionHeader}" />
                            <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                <TextBlock Text="{Binding QuerySummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding QueryError}" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap"
                                           Visibility="{Binding QueryError, Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>
                            <DataGrid Grid.Row="2" ItemsSource="{Binding Answers}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="70" />
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.4*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Resolver response" Style="{StaticResource SectionHeader}" />
                                <TextBlock Text="{Binding QueryDetails}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" />
                                <TextBlock Text="The resolver speaks DNS over UDP with a TCP fallback for truncated answers. No query is sent to a public resolver unless you select one or use the system default." 
                                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Recent queries" Style="{StaticResource SectionHeader}" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding History}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding QueryName}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding RecordType}" Width="70" />
                                <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="135" />
                                <DataGridTextColumn Header="OK" Binding="{Binding Success, Converter={StaticResource BoolToText}}" Width="50" />
                                <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs, StringFormat='{}{0:0} ms'}" Width="85" />
                                <DataGridTextColumn Header="When" Binding="{Binding Timestamp, Converter={StaticResource UtcToLocal}}" Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Local records">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RecordCount, StringFormat='{}{0} documented record(s)'}" Style="{StaticResource SectionHeader}" />
                                <Grid Width="230" Margin="12,0,0,0">
                                    <TextBox Text="{Binding RecordFilter, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Filter records" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding RecordFilter, Converter={StaticResource EmptyToVisibility}}" />
                                </Grid>
                            </StackPanel>
                            <Button Content="New record" Command="{Binding NewRecordCommand}" Style="{StaticResource AccentButton}" Padding="10,4" MinHeight="26" FontSize="11.5" HorizontalAlignment="Right" />
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding LocalRecords}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="140" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.4*" />
                                <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="70" />
                                <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Width="360" Style="{StaticResource Card}"
                        Visibility="{Binding IsRecordEditorOpen, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding RecordTitle}" Style="{StaticResource SectionHeader}" />
                                <Button Content="Close" Command="{Binding CancelRecordEditCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="Zone" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding EditorRecord.Zone, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding EditorRecord.Name, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Value" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding EditorRecord.Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding RecordTypes}" SelectedItem="{Binding EditorRecord.Type, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="TTL" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding EditorRecord.Ttl, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Server" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding EditorRecord.Server, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding EditorRecord.Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     Height="60" VerticalContentAlignment="Top" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Save" Command="{Binding SaveRecordCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                                <Button Content="Delete" Command="{Binding DeleteRecordCommand}" Style="{StaticResource DangerButton}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Local records are documentation kept in the IP Manager database. They are not served by a DNS server." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Integrations">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="390" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Configured integrations" Style="{StaticResource SectionHeader}" />
                            <Button Content="New" Command="{Binding NewIntegrationCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Integrations}" SelectedItem="{Binding SelectedIntegration, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,5">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Integration settings" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Provider" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ProviderKinds}" SelectedItem="{Binding ProviderKind, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                            <TextBlock Text="{Binding AccessText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding IntegrationName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Endpoint / base URL" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding IntegrationEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Username (if required)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding IntegrationUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Secret / token (leave blank to keep the current secret)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <PasswordBox x:Name="IntegrationSecretBox" PasswordChanged="OnSecretChanged" />
                            <TextBlock Text="Zone (Cloudflare)" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
                            <TextBox Text="{Binding IntegrationZone, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="Enabled" IsChecked="{Binding IntegrationEnabled}" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding IntegrationMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="Secrets are protected with Windows DPAPI for the current user. They are never stored in plain text or exported." 
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Save" Command="{Binding SaveIntegrationCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" />
                                <Button Content="Test" Command="{Binding TestIntegrationCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                                <Button Content="Delete" Command="{Binding DeleteIntegrationCommand}" Style="{StaticResource DangerButton}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardTight}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Remote records" Style="{StaticResource SectionHeader}" Margin="0" />
                            <Button Grid.Column="1" Content="Load records" Command="{Binding LoadRemoteRecordsCommand}" Style="{StaticResource SmallButton}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <DataGrid ItemsSource="{Binding RemoteRecords}" SelectedItem="{Binding SelectedRemoteRecord, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="120" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="65" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="1.5*" />
                                <DataGridTextColumn Header="TTL" Binding="{Binding Ttl}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource CardTight}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Create a remote record (write-capable providers only)" Style="{StaticResource FieldLabel}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="65" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewRemoteName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Record name" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding RecordTypes}" SelectedItem="{Binding NewRemoteType, Mode=TwoWay}" Margin="0,0,4,0" />
                                <TextBox Grid.Column="2" Text="{Binding NewRemoteValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="Record value" />
                                <TextBox Grid.Column="3" Text="{Binding NewRemoteTtl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" ToolTip="TTL" />
                                <Button Grid.Column="4" Content="Create" Command="{Binding CreateRemoteRecordCommand}" Style="{StaticResource SmallButton}"
                                        IsEnabled="{Binding CanWriteSelected}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Delete selected remote record" Command="{Binding DeleteRemoteRecordCommand}" Style="{StaticResource DangerButton}"
                                        IsEnabled="{Binding CanWriteSelected}" Padding="10,4" MinHeight="26" FontSize="11.5" />
                                <TextBlock Text="Read-only providers: Pi-hole, Windows DNS Server" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
